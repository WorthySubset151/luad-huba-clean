/* LUAD-HUBA TUI — motyw zielono-czarny w stylu terminala z/OS.
   Selektory celowo zachowawcze (kolory, tła, ramki) — bez kruchych
   pseudo-klas zależnych od wersji Textual. */

Screen {
    background: #04140a;
    color: #33ff66;
}

PanelHeader {
    height: 1;
    background: #07260f;
    padding: 0 1;
}

Footer {
    background: #07260f;
    color: #8affb0;
}

#body {
    padding: 1 2;
}

#menu-wrap {
    padding: 1 2;
}

#intro {
    padding: 0 0 1 0;
}

ListView {
    height: auto;
    background: #04140a;
    border: round #1f9d4d;
    padding: 1 1;
}

ListItem {
    background: #04140a;
    padding: 0 1;
}

#cmdline {
    height: auto;
    margin-top: 1;
}

#cmdlabel {
    width: auto;
    color: #8affb0;
    text-style: bold;
}

Input {
    background: #07260f;
    color: #33ff66;
}
